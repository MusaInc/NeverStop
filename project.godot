; Engine configuration file.
config_version=5

[application]

config/name="NEVER STOP"
config/description="Arcade police-pursuit survival. Musa Studios."
config/version="0.4.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.5", "Mobile")
config/icon="res://assets/icon_1024.png"
boot_splash/bg_color=Color(0.03, 0.035, 0.05, 1)
boot_splash/fullsize=true
boot_splash/use_filter=true

[autoload]

Settings="*res://src/core/settings.gd"
SaveData="*res://src/core/save_data.gd"
InputSetup="*res://src/input/input_setup.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/vsync/vsync_mode=1

[input_devices]

pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=false

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="buildings"
3d_physics/layer_3="vehicles"
3d_physics/layer_4="street"
3d_physics/layer_5="props"
3d_physics/layer_6="debris"

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=4
3d/physics_engine="Jolt Physics"

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
renderer/rendering_method.web="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
occlusion_culling/use_occlusion_culling=true
occlusion_culling/use_occlusion_culling.web=false
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3

[shader_globals]

player_pos={
"type": "vec3",
"value": Vector3(0, -1000, 0)
}
ground_height={
"type": "sampler2D",
"value": ""
}
ground_rect={
"type": "vec4",
"value": Vector4(0, 0, 1, 1)
}
sky_top={
"type": "vec3",
"value": Vector3(0.09, 0.26, 0.64)
}
sky_horizon={
"type": "vec3",
"value": Vector3(0.88, 0.65, 0.42)
}
sun_dir={
"type": "vec3",
"value": Vector3(0.73, 0.62, -0.29)
}
night={
"type": "float",
"value": 0.0
}
wetness={
"type": "float",
"value": 0.0
}
rain={
"type": "float",
"value": 0.0
}
traffic_time={
"type": "float",
"value": 0.0
}
